# Copy to the corresponding app .env.local / .env and fill locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public Supabase credentials are needed by the browser only for /admin sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EmailJS browser settings (public values; do not add an EmailJS private key).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# Configure the same URL/key in apps/api/.env for the API's RLS-protected access.
