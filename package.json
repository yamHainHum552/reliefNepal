{
  "name": "relief-nepal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace @relief-nepal/web run dev",
    "dev:api": "npm --workspace @relief-nepal/api run dev",
    "build": "npm --workspace @relief-nepal/web run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test apps/api/tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.27",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "prettier": "^3.4.2",
    "supabase": "^2.121.0"
  }
}
